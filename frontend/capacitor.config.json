{
  "appId": "org.weathergpt.app",
  "appName": "WeatherGPT",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#090d16",
      "showSpinner": true,
      "spinnerColor": "#0284c7"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#090d16"
    }
  }
}
